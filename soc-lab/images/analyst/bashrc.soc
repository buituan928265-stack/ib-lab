case $- in *i*)
  if [ -z "$SOC_GREETED" ]; then
    export SOC_GREETED=1
    echo
    echo "  Рабочее место аналитика SOC. Компания LAB, смена 20.10.2026."
    echo "  SIEM в браузере: http://127.0.0.1:5601"
    echo "  soc              — список заданий"
    echo "  soc 01           — открыть задание"
    echo "  soc check 01     — проверить ответы"
    echo "  soc data         — где лежат журналы"
    echo
  fi
  PS1='\[\e[1;36m\]analyst@soc\[\e[0m\]:\[\e[1;34m\]\w\[\e[0m\]\$ '
;; esac
