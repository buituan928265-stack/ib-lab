# Приветствие при входе в контейнер ученика
case $- in *i*)
  if [ -z "$LAB_GREETED" ]; then
    export LAB_GREETED=1
    echo
    echo "  Учебная лаборатория курса ИБ. Вы на компьютере ученика (192.168.10.25)."
    echo "  lab              — список заданий"
    echo "  lab 02           — открыть задание урока 02"
    echo "  lab check 02     — проверить ответы"
    echo "  exit             — выйти из лаборатории"
    echo
  fi
  PS1='\[\e[1;32m\]student@lab\[\e[0m\]:\[\e[1;34m\]\w\[\e[0m\]\$ '
;; esac
