# Учебный журнал DHCP-сервера. Данные вымышленные.
# Ноутбук с MAC 02:00:00:00:00:57 подключается к сети и получает настройки.
# Четыре шага DHCP: DISCOVER (ищу сервер) → OFFER (предлагаю адрес)
# → REQUEST (беру этот адрес) → ACK (подтверждаю).

2026-10-18T09:00:01Z dhcp DHCPDISCOVER(eth0) 02:00:00:00:00:57
2026-10-18T09:00:01Z dhcp DHCPOFFER(eth0) 192.168.10.57 02:00:00:00:00:57
2026-10-18T09:00:01Z dhcp DHCPREQUEST(eth0) 192.168.10.57 02:00:00:00:00:57
2026-10-18T09:00:01Z dhcp DHCPACK(eth0) 192.168.10.57 02:00:00:00:00:57 student-laptop
2026-10-18T09:00:01Z dhcp sent options to 02:00:00:00:00:57:
2026-10-18T09:00:01Z dhcp   lease time: 12h
2026-10-18T09:00:01Z dhcp   subnet mask: 255.255.255.0
2026-10-18T09:00:01Z dhcp   router: 192.168.10.1
2026-10-18T09:00:01Z dhcp   dns-server: 192.168.10.1
2026-10-18T09:00:01Z dhcp   domain-name: test
2026-10-18T15:00:03Z dhcp DHCPREQUEST(eth0) 192.168.10.57 02:00:00:00:00:57
2026-10-18T15:00:03Z dhcp DHCPACK(eth0) 192.168.10.57 02:00:00:00:00:57 student-laptop
